# =========================
# 1. Environnement uv / Python
# =========================
# On ignore les environnements virtuels (uv crée le dossier .venv par défaut)
.venv/
venv/
env/

# Fichiers compilés Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Artefacts de packaging produits par uv
build/
dist/
wheels/
*.egg-info

# =========================
# 2. Jupyter Notebooks
# =========================
.ipynb_checkpoints/
# Personal experiment notebooks. Copy a notebook here to work on it;
# git pull never touches this folder.
notebooks/scratch/

# =========================
# 2b. Experiment scripts
# =========================
# Ignore all files in the experiments scratch folder
experiments/scratch/*
# But keep the directory itself tracked
!experiments/scratch/.gitkeep
# (Optionnel) Ignorer les outputs de notebooks si on utilise des outils comme nbstripout
# *.ipynb

# =========================
# 3. Données Scientifiques & Simulations (TRÈS IMPORTANT)
# =========================
# On ne pousse JAMAIS les gros fichiers de données sur Git
*.hdf5
*.h5
*.npy
*.npz
*.dat
*.csv
# Small reference curves digitized from papers, committed on purpose.
!experiments/*/reference/*.csv
*.parquet
*.pkl

# Local datasets. Documented in README.md and never committed.
data/

# =========================
# 4. Logs et résultats de calculs
# =========================
*.log
*.out
*.err
outputs/
# Root-level results only: notebooks/results/ holds tracked notebooks (#147).
/results/
wandb/

# =========================
# 5. Outils de dev (tests, ruff, etc.)
# =========================
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# =========================
# 6. Secrets
# =========================
# Secrets locaux uniquement (mots de passe, clés API, chemins locaux).
# Les hyperparamètres scientifiques vont dans les YAML sous conf/.
.env

# =========================
# 7. Fichiers Système / IDE
# =========================
# Mac (essentiel pour toi)
.DS_Store
.AppleDouble
.LSOverride

# Éditeurs de code (VS Code, PyCharm, etc.)
.vscode/
.idea/
*.swp
